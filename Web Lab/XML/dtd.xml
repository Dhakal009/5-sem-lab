<!-- Write a DTD for an Online Bookstore XML -->

<? XML Version = “1.0” encoding= “UTF-8” ?>


<!DOCTYPE bookstore SYSTEM "bookstore.dtd">

<bookstore>
    ... book elements will go here ...
</bookstore>

<!-- DTD for Online Bookstore -->
<!ELEMENT bookstore (book+)>
<!ELEMENT book (title, author+, price, published_year?)>
<!ELEMENT title #PCDATA #REQUIRED>
<!ELEMENT author (first_name, last_name)>
<!ELEMENT price #PCDATA #REQUIRED>
<!ELEMENT published_year #PCDATA #IMPLIED>
<!ELEMENT first_name #PCDATA #REQUIRED>
<!ELEMENT last_name #PCDATA #REQUIRED>

<!ATTLIST book isbn ID >
<!ATTLIST book category #CDATA #IMPLIED >
